      { "handle": "npr.org", "name": "NPR", "all_election": true },
      { "handle": "politico.com", "name": "Politico", "all_election": true },
      { "handle": "cnn.com", "name": "CNN" },
      { "handle": "nbcnews.com", "name": "NBC News" },
      { "handle": "cbsnews.com", "name": "CBS News" },
      { "handle": "reuters.com", "name": "Reuters" },
      { "handle": "axios.com", "name": "Axios" },
      { "handle": "politicalwire.com", "name": "Political Wire", "all_election": true },
      { "handle": "thehill.com", "name": "The Hill" },
      { "handle": "punchbowlnews.com", "name": "Punchbowl News" },
      { "handle": "semafor.com", "name": "Semafor" },
